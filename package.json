{
  "name": "telegraph-cassandra",
  "version": "0.0.0",
  "private": true,
  "description": "Telegraph Protocol program submission: DWCS (Script Author track) and Sentinel (Application track).",
  "scripts": {
    "test": "jest",
    "test:dwcs": "jest dwcs/tests",
    "test:app": "jest app/tests",
    "typecheck": "tsc --noEmit",
    "preflight:sentinel": "node --experimental-strip-types --experimental-specifier-resolution=node app/src/preflight.ts",
    "smoke:sentinel": "node --experimental-strip-types --experimental-specifier-resolution=node app/src/smoke.ts",
    "bridge:sepolia-to-base": "node --experimental-strip-types --experimental-specifier-resolution=node scripts/bridge_sepolia_to_base.ts",
    "check:open-questions": "bash scripts/check_open_questions.sh"
  },
  "devDependencies": {
    "@types/jest": "^29.5.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.0",
    "typescript": "^5.5.0"
  },
  "dependencies": {
    "@x402/fetch": "^2.23.0",
    "@x402/evm": "^2.23.0",
    "viem": "^2.48.11"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node"
  }
}
